# DRAFT: candidate configuration; confirm service compatibility before an event.
# Copy to .env. Never print or commit the populated file.
# Choose a unique lowercase identifier (4-24 letters/digits/hyphens).
WORKSHOP_ID=northstar-your-id

ELASTICSEARCH_URL=
# Base Kibana URL without /s/<space>; set KIBANA_SPACE_ID separately.
KIBANA_URL=
KIBANA_SPACE_ID=default
# Setup key: workshop write + native Context Engine/workflow administration.
ELASTIC_API_KEY=
# Separate expiring runtime keys; never give either agent the setup key.
ELASTIC_BASELINE_API_KEY=
ELASTIC_OPTIMUS_API_KEY=

AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=
# Names or IDs of existing Foundry remote MCP project connections.
ELASTIC_BASELINE_CONNECTION=
ELASTIC_OPTIMUS_CONNECTION=

# Copy exact names advertised by MCP tools/list in your environment.
# Do not assume dotted Elastic tool IDs equal MCP wire names.
MCP_LIST_INDICES_TOOL=
MCP_MAPPING_TOOL=
MCP_ESQL_TOOL=
# Comma-separated native Context Engine list/describe/query MCP tool names.
# If absent from tools/list, stop and record the authoring release blocker.
MCP_CONTEXT_TOOLS=

# Set after creating the registered native AI Index in Challenge 02.
ELASTIC_AI_INDEX_ID=
# A local text file containing the actual native _describe response.
ELASTIC_AI_INDEX_DESCRIPTION_FILE=outputs/ai-index-description.json

# Author-only release gate for the proposed evaluator mapping.
# Leave false until the full tool-context schema is accepted and interpreted.
INDIRECT_ATTACK_MAPPING_CONFIRMED=false
