{
  "name": "Context Quest - draft",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "postCreateCommand": "python -m pip install -r requirements.txt && python -m ipykernel install --user --name context-quest --display-name 'Python (Context Quest)'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "github.copilot",
        "github.copilot-chat"
      ]
    },
    "codespaces": {
      "openFiles": ["README.md", "notebooks/00-Setup.ipynb"]
    }
  }
}
